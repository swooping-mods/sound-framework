{
  "id": "sound-framework",
  "kind": "native",
  "version": "0.1.3",
  "feature_dependencies": [],
  "gameplay": true,
  "display_name": "Sound Framework",
  "play_help": [
    "Shared spatial sound cues, bounded voices and game SFX volume for provider mods."
  ],
  "provides": {
    "sound-framework.sound": {
      "abi": 1,
      "size": 48,
      "limits": {
        "max_cues": 64,
        "max_voices": 16
      }
    },
    "sound-framework.sound-assets": {
      "abi": 1,
      "size": 32,
      "limits": {
        "max_assets": 16,
        "max_samples": 3000000
      }
    },
    "sound-framework.sound-preparation": {
      "abi": 1,
      "size": 16
    }
  }
}
